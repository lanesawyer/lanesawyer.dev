---
import { getEmDashCollection, getTermsForEntries } from "emdash";
import Base from "../../../layouts/Base.astro";
import PostCard from "../../../components/PostCard.astro";
import { getReadingTime } from "../../../utils/reading-time";

const year = Number(Astro.params.year);
const month = Astro.params.month ? Number(Astro.params.month) : null;

const validYear = /^\d{4}$/.test(Astro.params.year ?? "");
const validMonth =
	month === null ||
	(/^\d{2}$/.test(Astro.params.month ?? "") && month >= 1 && month <= 12);

if (!validYear || !validMonth) {
	return Astro.redirect("/404");
}

// The core:archives widget groups by the server's local time (UTC on Fly),
// so the range bounds are UTC to match its counts.
const start = new Date(Date.UTC(year, month ? month - 1 : 0, 1));
const end = month
	? new Date(Date.UTC(year, month, 1))
	: new Date(Date.UTC(year + 1, 0, 1));

const label = month
	? start.toLocaleDateString("en-US", {
			year: "numeric",
			month: "long",
			timeZone: "UTC",
		})
	: `${year}`;
const basePath = month
	? `/archives/${year}/${Astro.params.month}`
	: `/archives/${year}`;

const cursor = Astro.url.searchParams.get("cursor") || undefined;
const {
	entries: posts,
	cacheHint,
	nextCursor,
} = await getEmDashCollection("posts", {
	where: {
		published_at: { gte: start.toISOString(), lt: end.toISOString() },
	},
	orderBy: { published_at: "desc" },
	limit: 20,
	cursor,
});

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
}

const tagsByEntry = await getTermsForEntries(
	"posts",
	posts.map((p) => p.data.id),
	"tag",
);
const filteredPosts = posts.map((post) => ({
	post,
	tags: tagsByEntry.get(post.data.id) ?? [],
}));
---

<Base title={`Posts from ${label}`} description={`All posts published in ${label}`}>
	<section class="archive-section">
		<header class="archive-header">
			<span class="archive-label">Archive</span>
			<h1 class="archive-title">{label}</h1>
		</header>

		{
			filteredPosts.length === 0 ? (
				<p class="no-posts">No posts from {label}.</p>
			) : (
				<div class="posts-grid">
					{filteredPosts.map(({ post, tags }) => (
						<PostCard
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={`/posts/${post.id}`}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							tags={tags.map((t) => ({ slug: t.slug, label: t.label }))}
							edit={post.edit}
						/>
					))}
				</div>
			)
		}
		<nav class="pagination" aria-label="Pagination">
			{cursor && <a href={basePath}>First page</a>}
			{
				nextCursor && (
					<a href={`${basePath}?cursor=${encodeURIComponent(nextCursor)}`}>
						Next page
					</a>
				)
			}
		</nav>
	</section>
</Base>

<style>
	.archive-section {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-label {
		display: block;
		font-size: var(--font-size-xs);
		font-weight: 500;
		color: var(--color-brand);
		text-transform: uppercase;
		letter-spacing: var(--tracking-wider);
		margin-bottom: var(--spacing-2);
	}

	.archive-title {
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		letter-spacing: var(--tracking-tight);
		margin-bottom: var(--spacing-2);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
